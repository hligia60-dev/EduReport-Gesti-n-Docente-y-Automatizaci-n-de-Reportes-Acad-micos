# Entorno Virtual Python
.venv/
venv/
ENV/
env/

# Bytecode y Caché de Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Base de Datos local SQLite
*.db
*.sqlite
*.sqlite3
instance/
database/*.db

# Variables de entorno y credenciales
.env
.env.*
!.env.example

# Archivos generados dinámicamente (Reportes / Informes)
reports/generated/*
!reports/generated/.gitkeep

# Archivos temporales de importación
imports/*
!imports/.gitkeep

# Entornos de desarrollo y editores
.vscode/
.idea/
*.swp
*.swo

# Archivos de sistema operativo
Thumbs.db
Desktop.ini
.DS_Store
